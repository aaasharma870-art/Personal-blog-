# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project briefs / agent tooling — kept out of the public repo
/CLAUDE.md
/BUILD-PROMPT.md
/AGENTS.md
/skills-lock.json

# local QA / screenshot scratch
/.playwright-mcp/

# media masters (3–4k Higgsfield originals) — never shipped; run
# `npm run optimize:media` to regenerate the capped public/media deliverables
/media-src/

# design specs / build plans (AI process) — kept out of the public repo
/docs/superpowers/

# personal-use / desktop-licence font binaries (SPEC §9.7 mode B): never in git
/design-src/fonts-personal/

# capture harness deps + locks (tools/capture)
/tools/capture/node_modules/
/tools/capture/package.json
/tools/capture/package-lock.json
/tools/capture/.browser-locks/

# capture frames (large PNGs; contact sheets reference them locally)
/docs/build/m2-after/*.png
/docs/build/final-frames/*.png
/docs/build/m2-after2/*.png
/docs/build/final-frames/qa/*.png
/docs/build/final-frames/qa/supp/*.png

# Phase 3 probe screenshots (raw PNG; summaries/JSON/JPG strips are committed instead)
/docs/build/motion-strips/p3-w*/probes-*/**/*.png
/docs/build/motion-strips/p3-w*/probes-*/*.png

# Phase 3 critic-loop rounds: raw screencast video, frames, per-clip strips and PNG probe shots stay local
# (tools/capture/screencast.mjs --raw, clips.mjs --raw); JSON, Markdown and JPG contact sheets are committed
/docs/build/motion-strips/p3-r*/raw/
/docs/build/motion-strips/p3-r*/**/*.png
/docs/build/motion-strips/p3-r*/**/*.mp4
/docs/build/motion-strips/p3-r*/**/*.webm
